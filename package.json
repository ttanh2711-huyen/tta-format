{
  "name": "nd30-word-addin",
  "version": "1.0.12",
  "private": true,
  "description": "Add-in Word định dạng văn bản theo Nghị định 30/2020/NĐ-CP và Hướng dẫn 05-HD/VPTW",
  "config": {
    "app_to_debug": "word",
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "build:release": "webpack --mode production --env release",
    "manifest:release": "node tools/make-manifest.js",
    "manifest:root": "node tools/make-manifest.js https://ttanh2711-huyen.github.io/tta-format .",
    "check:release": "node tools/check-release.js",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.dev.xml desktop",
    "stop": "office-addin-debugging stop manifest.dev.xml",
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "office-addin-manifest validate manifest.dev.xml && office-addin-manifest validate manifest.xml"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/office-js": "^1.0.611",
    "adm-zip": "^0.6.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.12.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
